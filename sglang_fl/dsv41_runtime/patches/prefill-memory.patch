@@ -1131,0 +1132,20 @@
+def _candidate_block_amax(logits: torch.Tensor, block_size: int) -> torch.Tensor:
+    """Exact block maxima without a token-sized padded copy.
+
+    Complete blocks already have their final layout. Only the last partial
+    block needs -inf padding; padding the full matrix also copies aligned
+    inputs and can transiently duplicate a GiB of prefill scores.
+    """
+    width = logits.size(-1)
+    padding = -width % block_size
+    if padding == 0:
+        return logits.unflatten(-1, (-1, block_size)).amax(dim=-1)
+    full_width = width - width % block_size
+    tail = F.pad(logits[..., full_width:], (0, padding), value=-torch.inf)
+    tail_scores = tail.amax(dim=-1, keepdim=True)
+    if full_width == 0:
+        return tail_scores
+    full_scores = logits[..., :full_width].unflatten(-1, (-1, block_size)).amax(dim=-1)
+    return torch.cat((full_scores, tail_scores), dim=-1)
+
+
