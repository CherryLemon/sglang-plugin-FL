                 self.assertEqual(kv_args.state_data_ptrs[-1], expected_infos[0])
diff --git a/test/registered/unit/disaggregation/test_dsv41_dspark_pd.py b/test/registered/unit/disaggregation/test_dsv41_dspark_pd.py
