+def _fp4_e2m1_code_rne(x):
+    """Round-to-nearest-even e2m1 code, matching the reference rounding: at an
+    exact half-way value the even grid index wins."""
+    ax = tl.minimum(tl.abs(x), 6.0)
+    idx = (ax >= 0.25).to(tl.uint8)
