+        )
+        try:
+            t = _build(12, 2, seed=418)
+            t.draft_len = 6
+            t.req.copy_(torch.arange(2, device="cuda").repeat_interleave(6))
+            t.pos.copy_(
+                (
+                    torch.tensor([31, 32], device="cuda")[:, None]
+                    + torch.arange(6, device="cuda")
