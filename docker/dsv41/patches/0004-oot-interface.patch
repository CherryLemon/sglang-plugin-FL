diff --git a/python/sglang/srt/layers/dsv41_ops.py b/python/sglang/srt/layers/dsv41_ops.py
new file mode 100644
index 0000000000..6fa945f650
--- /dev/null
+++ b/python/sglang/srt/layers/dsv41_ops.py
@@ -0,0 +1,52 @@
+"""Versioned, optional OOT interface for DeepSeek V4.1 numerical kernels.
+
+The engine owns model/state semantics; a plugin selects an implementation before
+launch. Exceptions are propagated, never interpreted as a request to retry with
+another backend. Importing this module does not initialize a device.
+"""
+
+from functools import wraps
+import os
+from typing import Callable, Optional
+
+ABI_VERSION = 1
+_dispatch: Optional[Callable] = None
+_validate_model: Optional[Callable] = None
+
+
+def register_backend(dispatch: Callable, *, abi_version: int, validate_model=None):
+    global _dispatch, _validate_model
+    if abi_version != ABI_VERSION:
+        raise RuntimeError(f"DSV4.1 OOT ABI mismatch: {abi_version} != {ABI_VERSION}")
+    if _dispatch is not None and _dispatch is not dispatch:
+        raise RuntimeError("A DSV4.1 OOT backend is already registered")
+    _dispatch, _validate_model = dispatch, validate_model
+
+
+def require_backend():
+    if _dispatch is None and os.environ.get("SGLANG_FL_DSV41_REQUIRED", "0") == "1":
+        raise RuntimeError(
+            "DSV4.1 requires sglang_fl initialization; check plugin startup errors "
+            "and SGLANG_PLUGINS (expected sglang_fl)"
+        )
+
+
+def validate_model(config):
+    require_backend()
+    if _validate_model is not None:
+        _validate_model(config)
+
+
+def dsv41_op(name: str):
+    def decorate(native):
+        @wraps(native)
+        def wrapped(*args, **kwargs):
+            require_backend()
+            if _dispatch is None:
+                return native(*args, **kwargs)
+            return _dispatch(name, native, *args, **kwargs)
+
+        wrapped.__dsv41_op__ = name
+        return wrapped
+
+    return decorate
